# Copie este arquivo para ".env" e preencha apenas o que for confirmado.
# Variáveis PUBLIC_* ficam visíveis no navegador (são IDs públicos, nunca segredos).
# Deixe vazio para desativar a integração: a página funciona normalmente sem elas.

# URL pública final do site (sem barra no final). Usada em canonical, Open Graph e sitemap.
PUBLIC_SITE_URL=

# Google Tag Manager (formato GTM-XXXXXXX). Recomendado: gerencia GA4 e Google Ads.
PUBLIC_GTM_ID=

# Google Analytics 4 (formato G-XXXXXXXXXX). Só é carregado diretamente se NÃO houver GTM.
PUBLIC_GA4_ID=

# Google Ads (formato AW-XXXXXXXXX). Só é carregado diretamente se NÃO houver GTM.
PUBLIC_GOOGLE_ADS_ID=

# Consent Mode v2: "true" define o consentimento como negado por padrão até a chamada
# window.apolloConsent.grant() (ver docs/MENSURACAO.md). Use conforme sua política de privacidade.
PUBLIC_CONSENT_MODE=false

# ID do vídeo do YouTube (apenas o ID, ex.: o trecho depois de "v=" na URL). Vazio = "em breve".
PUBLIC_YOUTUBE_VIDEO_ID=

# Perfil do Instagram (URL completa). Vazio = o link não é exibido.
PUBLIC_INSTAGRAM_URL=

# Páginas legais (URLs completas ou caminhos). Vazio = os links não são exibidos.
PUBLIC_PRIVACY_URL=
PUBLIC_COOKIES_URL=

# Caminho base do deploy. Padr�o: /apollo-body-health/ (GitHub Pages). Use / em dom�nio pr�prio.
PUBLIC_BASE_PATH=
