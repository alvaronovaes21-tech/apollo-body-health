---
import Photo from './Photo.astro';
import Icon from './Icon.astro';
import Button from './Button.astro';
import WhatsAppButton from './WhatsAppButton.astro';
import { MESSAGES } from '@/lib/messages';
import { SECTIONS, SITE } from '@/config/site';
import { resolveImage } from '@/lib/images';

const heroIsProvisional = resolveImage('hero', 'hero', 'hero-treino')?.provisional ?? false;
---

<section class="hero" id={SECTIONS.inicio} aria-labelledby="hero-title">
  <div class="hero__media" aria-hidden="false">
    <!-- Foto real: src/assets/images/hero/hero.jpg (substitui automaticamente a provisória). -->
    <Photo
      folder="hero"
      name="hero"
      fallback="hero-treino"
      alt="Treino de força em academia, com barra e anilhas sobre piso emborrachado"
      sizes="100vw"
      widths={[640, 960, 1280, 1600, 2000]}
      priority
      position="62% 50%"
      badge={false}
    />
  </div>
  <div class="hero__shade" aria-hidden="true"></div>
  <div class="hero__glow" aria-hidden="true"></div>

  <div class="container hero__inner">
    <div class="hero__content">
      <p class="hero__place">
        <Icon name="pin" size={16} />
        <span>{SITE.city}, Bahia</span>
      </p>

      <h1 id="hero-title" class="hero__title">
        Seu treino merece mais. <span>Sua experiência também.</span>
      </h1>

      <p class="hero__lead">
        Na Apollo Body &amp; Health, você encontra diferentes modalidades, profissionais preparados e um ambiente
        pensado para transformar a sua relação com o movimento, a saúde e o bem-estar.
      </p>
      <p class="hero__sub">
        Musculação, aulas coletivas e artes marciais em um só lugar, com opções para diferentes objetivos, rotinas e
        fases da vida.
      </p>

      <div class="hero__actions">
        <WhatsAppButton message={MESSAGES.general} origin="hero" category="general" size="lg">
          Quero conhecer a academia
        </WhatsAppButton>
        <Button href={`#${SECTIONS.modalidades}`} variant="secondary" size="lg" iconAfter="arrow-right">
          Conheça nossas modalidades
        </Button>
      </div>

      <p class="hero__benefit">
        <Icon name="ticket" size={18} />
        <span>
          Aceitamos <strong>Wellhub</strong> e <strong>TotalPass</strong>
        </span>
      </p>
    </div>
  </div>

  {heroIsProvisional && <p class="hero__caption">Imagem ilustrativa provisória</p>}
</section>

<style>
  .hero {
    position: relative;
    display: flex;
    align-items: flex-end;
    min-height: max(100svh, 640px);
    padding-top: calc(var(--header-h) + 2rem);
    padding-bottom: clamp(3.5rem, 8vw, 6rem);
    overflow: hidden;
    isolation: isolate;
  }
  .hero__media {
    position: absolute;
    inset: 0;
    z-index: -3;
  }
  .hero__shade {
    position: absolute;
    inset: 0;
    z-index: -2;
    background:
      linear-gradient(180deg, rgb(5 8 13 / 0.78) 0%, rgb(5 8 13 / 0.35) 32%, rgb(5 8 13 / 0.9) 82%, var(--bg) 100%),
      linear-gradient(90deg, rgb(5 8 13 / 0.92) 0%, rgb(5 8 13 / 0.55) 55%, rgb(5 8 13 / 0.15) 100%);
  }
  .hero__glow {
    position: absolute;
    z-index: -1;
    inset: auto -10% -35% -10%;
    height: 70%;
    background: radial-gradient(50% 60% at 30% 50%, rgb(25 195 255 / 0.22), transparent 70%);
    pointer-events: none;
  }
  .hero__inner {
    width: min(100% - 2.5rem, var(--container));
  }
  .hero__content {
    max-width: 44rem;
  }
  .hero__place {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 1.25rem;
    padding: 0.4rem 0.9rem 0.4rem 0.7rem;
    border: 1px solid rgb(25 195 255 / 0.35);
    border-radius: 999px;
    background: rgb(25 195 255 / 0.08);
    font-family: var(--font-display);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--cyan);
    backdrop-filter: blur(6px);
  }
  .hero__title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(2.35rem, 1.3rem + 5.6vw, 4.9rem);
    line-height: 1.04;
    letter-spacing: -0.035em;
    text-wrap: balance;
  }
  .hero__title span {
    display: block;
    color: var(--cyan);
  }
  .hero__lead {
    margin-top: 1.4rem;
    max-width: 38rem;
    font-size: clamp(1.02rem, 0.95rem + 0.4vw, 1.2rem);
    color: rgb(243 246 250 / 0.92);
  }
  .hero__sub {
    margin-top: 0.9rem;
    max-width: 36rem;
    color: var(--muted);
  }
  .hero__actions {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-top: 2rem;
  }
  .hero__benefit {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    margin-top: 1.75rem;
    padding: 0.55rem 1rem;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    background: rgb(5 8 13 / 0.55);
    backdrop-filter: blur(8px);
    font-size: 0.9rem;
    color: var(--muted);
  }
  .hero__benefit :global(svg) {
    color: var(--cyan);
  }
  .hero__benefit strong {
    color: var(--text);
    font-weight: 700;
  }
  .hero__caption {
    position: absolute;
    right: 1rem;
    top: calc(var(--header-h) + 0.6rem);
    font-size: 0.66rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: rgb(255 255 255 / 0.45);
  }

  @media (min-width: 640px) {
    .hero__actions {
      flex-direction: row;
      flex-wrap: wrap;
    }
  }
  @media (max-width: 639px) {
    /* No celular, o CTA principal sobe para a primeira tela e o texto complementar vem logo abaixo. */
    .hero__content {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
    }
    .hero__actions {
      order: 4;
      width: 100%;
      margin-top: 1.5rem;
    }
    .hero__sub {
      order: 5;
      font-size: 0.92rem;
    }
    .hero__benefit {
      order: 6;
      margin-top: 1.1rem;
    }
    .hero__lead {
      font-size: 1rem;
    }
    .hero__caption {
      display: none;
    }
  }
</style>
