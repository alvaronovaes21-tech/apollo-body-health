---
import Icon from './Icon.astro';
import SectionHeading from './SectionHeading.astro';
import WhatsAppButton from './WhatsAppButton.astro';
import { PLANS, PLANS_NOTE, PLAN_EXCLUSION_NOTE, JIU_JITSU_PLANS, JIU_JITSU_SECTION } from '@/data/plans';
import { MESSAGES } from '@/lib/messages';
import { SECTIONS } from '@/config/site';
---

<section class="section plans" id={SECTIONS.planos} aria-labelledby="plans-title">
  <div class="container">
    <SectionHeading
      eyebrow="Planos e investimento"
      title="Escolha o plano ideal <em>para sua rotina.</em>"
      subtitle="Opções para quem busca flexibilidade ou deseja se comprometer com uma jornada de treino de longo prazo."
      id="plans-title"
    />

    <ul class="plans__grid">
      {
        PLANS.map((plan, i) => (
          <li
            class:list={['plan', { 'plan--featured': plan.featured }]}
            data-reveal
            style={`--reveal-delay:${i * 90}ms`}
          >
            <article aria-labelledby={`plan-${plan.id}`}>
              {plan.badge && <p class="plan__badge">{plan.badge}</p>}
              <h3 class="plan__name" id={`plan-${plan.id}`}>
                {plan.name}
              </h3>
              <p class="plan__tagline">{plan.tagline}</p>

              <div class="plan__pricing">
                <div class="plan__price">
                  <strong>{plan.price}</strong>
                  {plan.priceSuffix && <span>{plan.priceSuffix}</span>}
                </div>
                {plan.priceDetails.length > 0 && (
                  <ul class="plan__details">
                    {plan.priceDetails.map((d) => (
                      <li>{d}</li>
                    ))}
                  </ul>
                )}
              </div>

              <ul class="plan__features">
                {plan.features.map((f) => (
                  <li>
                    <Icon name="check" size={18} />
                    <span>{f}</span>
                  </li>
                ))}
              </ul>

              <p class="plan__exclusion">
                <Icon name="shield" size={16} />
                <span>{PLAN_EXCLUSION_NOTE}</span>
              </p>

              <WhatsAppButton
                message={MESSAGES.plan(plan.whatsappName)}
                origin="planos"
                category="plan"
                item={plan.name}
                variant={plan.featured ? 'primary' : 'secondary'}
                block
              >
                {plan.cta}
              </WhatsAppButton>
            </article>
          </li>
        ))
      }
    </ul>

    <section class="bjj" id="jiu-jitsu-apollo" aria-labelledby="bjj-title">
      <header class="bjj__head" data-reveal>
        <p class="bjj__eyebrow">
          <Icon name="belt" size={16} />
          Artes marciais
        </p>
        <h3 class="bjj__title" id="bjj-title">{JIU_JITSU_SECTION.title}</h3>
        <p class="bjj__subtitle">{JIU_JITSU_SECTION.subtitle}</p>
        <p class="bjj__highlight">{JIU_JITSU_SECTION.highlight}</p>
      </header>

      <ul class="bjj__grid">
        {
          JIU_JITSU_PLANS.map((p, i) => (
            <li class="bjj__item" data-reveal style={`--reveal-delay:${i * 90}ms`}>
              <article class="bjj__card" aria-labelledby={`plan-${p.id}`}>
                <div class="bjj__icon" aria-hidden="true">
                  <Icon name={p.icon} size={26} />
                </div>
                <h4 class="bjj__name" id={`plan-${p.id}`}>
                  {p.name}
                </h4>
                <div class="bjj__price">
                  <strong>{p.price}</strong>
                  <span>{p.priceSuffix}</span>
                </div>
                <p class="bjj__desc">{p.description}</p>
                <WhatsAppButton
                  message={p.whatsappMessage}
                  origin="planos-jiu-jitsu"
                  category="plan"
                  item={p.trackingItem}
                  variant="secondary"
                  block
                >
                  {p.cta}
                </WhatsAppButton>
              </article>
            </li>
          ))
        }
      </ul>
    </section>

    <p class="plans__note" data-reveal>
      {PLANS_NOTE}
    </p>
    <p class="plans__more" data-reveal>
      Prefere conversar antes de decidir?
      <WhatsAppButton message={MESSAGES.plans} origin="planos-geral" category="plan" item="Todos os planos" variant="ghost">
        Falar sobre os planos
      </WhatsAppButton>
    </p>
  </div>
</section>

<style>
  .plans {
    background: radial-gradient(70% 50% at 50% 100%, rgb(25 195 255 / 0.08), transparent 70%), var(--bg);
  }
  .plans__grid {
    display: grid;
    gap: 1.25rem;
    align-items: stretch;
  }
  .plan {
    display: flex;
  }
  .plan article {
    position: relative;
    display: flex;
    flex: 1;
    flex-direction: column;
    padding: clamp(1.6rem, 3vw, 2.25rem);
    border: 1px solid var(--line);
    border-radius: 24px;
    background: linear-gradient(180deg, rgb(255 255 255 / 0.04), rgb(255 255 255 / 0.01)), var(--surface);
    transition:
      border-color 0.35s var(--ease),
      box-shadow 0.35s var(--ease);
  }
  .plan article:hover {
    border-color: rgb(25 195 255 / 0.4);
  }
  .plan--featured article {
    border-color: rgb(25 195 255 / 0.55);
    background:
      radial-gradient(90% 60% at 50% 0%, rgb(25 195 255 / 0.16), transparent 70%),
      linear-gradient(180deg, rgb(255 255 255 / 0.05), rgb(255 255 255 / 0.01)), var(--surface);
    box-shadow:
      0 0 0 1px rgb(25 195 255 / 0.2),
      0 40px 80px -40px rgb(25 195 255 / 0.55);
  }
  .plan__badge {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translate(-50%, -50%);
    padding: 0.35rem 1rem;
    border-radius: 999px;
    background: var(--cyan);
    color: #021018;
    font-family: var(--font-display);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    white-space: nowrap;
  }
  .plan__name {
    font-family: var(--font-display);
    font-size: 1.45rem;
    letter-spacing: -0.02em;
  }
  .plan__tagline {
    margin-top: 0.35rem;
    color: var(--muted);
    font-size: 0.95rem;
  }
  .plan__price {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 0.6rem;
    margin-top: 1.5rem;
  }
  .plan__price strong {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(2rem, 1.6rem + 1.4vw, 2.6rem);
    letter-spacing: -0.03em;
    line-height: 1;
  }
  .plan__price span {
    color: var(--muted);
    font-size: 0.92rem;
  }
  .plan__details {
    display: grid;
    gap: 0.2rem;
    margin-top: 0.75rem;
    font-size: 0.92rem;
    color: var(--cyan);
    font-weight: 600;
  }
  .plan__features {
    display: grid;
    gap: 0.75rem;
    flex: 1;
    margin: 1.6rem 0 1.75rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
  }
  .plan__features li {
    display: flex;
    gap: 0.7rem;
    align-items: flex-start;
    font-size: 0.97rem;
  }
  .plan__features :global(svg) {
    flex: none;
    margin-top: 0.15rem;
    color: var(--cyan);
  }
  .plan__exclusion {
    display: flex;
    gap: 0.6rem;
    align-items: flex-start;
    margin: 0 0 1.5rem;
    padding: 0.75rem 0.9rem;
    border-left: 2px solid var(--cyan);
    border-radius: 0 12px 12px 0;
    background: rgb(25 195 255 / 0.07);
    font-size: 0.93rem;
    font-weight: 600;
    line-height: 1.4;
  }
  .plan__exclusion :global(svg) {
    flex: none;
    margin-top: 0.15rem;
    color: var(--cyan);
  }

  /* ---------- Jiu-Jitsu Apollo ---------- */
  .bjj {
    position: relative;
    margin-top: clamp(3.5rem, 8vw, 6rem);
    padding: clamp(2rem, 5vw, 3.5rem) clamp(1.1rem, 4vw, 3rem) clamp(1.75rem, 4vw, 3rem);
    border: 1px solid var(--line);
    border-radius: 32px;
    background:
      radial-gradient(60% 70% at 50% 0%, rgb(25 195 255 / 0.1), transparent 70%),
      linear-gradient(180deg, rgb(255 255 255 / 0.03), rgb(255 255 255 / 0)), #05090d;
  }
  .bjj__head {
    max-width: 44rem;
    margin: 0 auto clamp(1.75rem, 4vw, 2.75rem);
    text-align: center;
  }
  .bjj__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0 0 1rem;
    font-family: var(--font-display);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--cyan);
  }
  .bjj__title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(1.8rem, 1.2rem + 2.8vw, 2.8rem);
    line-height: 1.1;
    letter-spacing: 0.02em;
    color: var(--cyan);
  }
  .bjj__subtitle {
    margin: 1rem 0 0;
    color: var(--muted);
    font-size: clamp(1rem, 0.95rem + 0.3vw, 1.12rem);
    text-wrap: pretty;
  }
  .bjj__highlight {
    margin: 1.4rem auto 0;
    padding: 0.9rem 1.25rem;
    max-width: 36rem;
    border-block: 1px solid rgb(25 195 255 / 0.3);
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(1rem, 0.95rem + 0.3vw, 1.12rem);
    line-height: 1.4;
    text-wrap: balance;
  }
  .bjj__grid {
    display: grid;
    gap: 1.25rem;
    max-width: 60rem;
    margin-inline: auto;
  }
  .bjj__item {
    display: flex;
  }
  .bjj__card {
    display: flex;
    flex: 1;
    flex-direction: column;
    padding: clamp(1.5rem, 3vw, 2.1rem);
    border: 1px solid var(--line);
    border-radius: 24px;
    background: linear-gradient(180deg, rgb(255 255 255 / 0.04), rgb(255 255 255 / 0.01)), var(--surface);
    transition: border-color 0.35s var(--ease);
  }
  .bjj__card:hover {
    border-color: rgb(25 195 255 / 0.4);
  }
  .bjj__icon {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border-radius: 14px;
    border: 1px solid rgb(25 195 255 / 0.35);
    background: rgb(25 195 255 / 0.08);
    color: var(--cyan);
  }
  .bjj__name {
    margin-top: 1.1rem;
    font-family: var(--font-display);
    font-size: 1.35rem;
    letter-spacing: -0.02em;
  }
  .bjj__price {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 0.6rem;
    margin-top: 1rem;
  }
  .bjj__price strong {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(2rem, 1.6rem + 1.4vw, 2.6rem);
    letter-spacing: -0.03em;
    line-height: 1;
  }
  .bjj__price span {
    color: var(--muted);
    font-size: 0.92rem;
  }
  .bjj__desc {
    flex: 1;
    margin: 1.1rem 0 1.6rem;
    padding-top: 1.1rem;
    border-top: 1px solid var(--line);
    color: var(--muted);
    font-size: 0.97rem;
  }
  @media (min-width: 720px) {
    .bjj__grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 1.5rem;
    }
  }

  .plans__note {
    max-width: 44rem;
    margin: 2.5rem auto 0;
    text-align: center;
    font-size: 0.9rem;
    color: var(--muted);
  }
  .plans__more {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.75rem 1rem;
    margin-top: 1.25rem;
    color: var(--muted);
    text-align: center;
  }

  @media (min-width: 900px) {
    /* Alinha o início das listas de benefícios entre os três cartões */
    .plan__pricing {
      min-height: 8.6rem;
    }
    .plan__tagline {
      min-height: 3.2em;
    }
    .plans__grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 1.5rem;
    }
    .plan--featured {
      margin-block: -0.75rem;
    }
  }
</style>
