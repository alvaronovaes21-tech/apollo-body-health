---
import Icon from './Icon.astro';
import SectionHeading from './SectionHeading.astro';
import WhatsAppButton from './WhatsAppButton.astro';
import { PLANS, PLANS_NOTE } from '@/data/plans';
import { MESSAGES } from '@/lib/messages';
import { SECTIONS } from '@/config/site';
---

<section class="section plans" id={SECTIONS.planos} aria-labelledby="plans-title">
  <div class="container">
    <SectionHeading
      eyebrow="Planos e investimento"
      title="Escolha o plano ideal <em>para sua rotina.</em>"
      subtitle="Opções para quem busca flexibilidade ou deseja se comprometer com uma jornada de treino de longo prazo."
      id="plans-title"
    />

    <ul class="plans__grid">
      {
        PLANS.map((plan, i) => (
          <li
            class:list={['plan', { 'plan--featured': plan.featured }]}
            data-reveal
            style={`--reveal-delay:${i * 90}ms`}
          >
            <article aria-labelledby={`plan-${plan.id}`}>
              {plan.badge && <p class="plan__badge">{plan.badge}</p>}
              <h3 class="plan__name" id={`plan-${plan.id}`}>
                {plan.name}
              </h3>
              <p class="plan__tagline">{plan.tagline}</p>

              <div class="plan__pricing">
                <div class="plan__price">
                  <strong>{plan.price}</strong>
                  {plan.priceSuffix && <span>{plan.priceSuffix}</span>}
                </div>
                {plan.priceDetails.length > 0 && (
                  <ul class="plan__details">
                    {plan.priceDetails.map((d) => (
                      <li>{d}</li>
                    ))}
                  </ul>
                )}
              </div>

              <ul class="plan__features">
                {plan.features.map((f) => (
                  <li>
                    <Icon name="check" size={18} />
                    <span>{f}</span>
                  </li>
                ))}
              </ul>

              <WhatsAppButton
                message={MESSAGES.plan(plan.whatsappName)}
                origin="planos"
                category="plan"
                item={plan.name}
                variant={plan.featured ? 'primary' : 'secondary'}
                block
              >
                {plan.cta}
              </WhatsAppButton>
            </article>
          </li>
        ))
      }
    </ul>

    <p class="plans__note" data-reveal>
      {PLANS_NOTE}
    </p>
    <p class="plans__more" data-reveal>
      Prefere conversar antes de decidir?
      <WhatsAppButton message={MESSAGES.plans} origin="planos-geral" category="plan" item="Todos os planos" variant="ghost">
        Falar sobre os planos
      </WhatsAppButton>
    </p>
  </div>
</section>

<style>
  .plans {
    background: radial-gradient(70% 50% at 50% 100%, rgb(25 195 255 / 0.08), transparent 70%), var(--bg);
  }
  .plans__grid {
    display: grid;
    gap: 1.25rem;
    align-items: stretch;
  }
  .plan {
    display: flex;
  }
  .plan article {
    position: relative;
    display: flex;
    flex: 1;
    flex-direction: column;
    padding: clamp(1.6rem, 3vw, 2.25rem);
    border: 1px solid var(--line);
    border-radius: 24px;
    background: linear-gradient(180deg, rgb(255 255 255 / 0.04), rgb(255 255 255 / 0.01)), var(--surface);
    transition:
      border-color 0.35s var(--ease),
      box-shadow 0.35s var(--ease);
  }
  .plan article:hover {
    border-color: rgb(25 195 255 / 0.4);
  }
  .plan--featured article {
    border-color: rgb(25 195 255 / 0.55);
    background:
      radial-gradient(90% 60% at 50% 0%, rgb(25 195 255 / 0.16), transparent 70%),
      linear-gradient(180deg, rgb(255 255 255 / 0.05), rgb(255 255 255 / 0.01)), var(--surface);
    box-shadow:
      0 0 0 1px rgb(25 195 255 / 0.2),
      0 40px 80px -40px rgb(25 195 255 / 0.55);
  }
  .plan__badge {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translate(-50%, -50%);
    padding: 0.35rem 1rem;
    border-radius: 999px;
    background: var(--cyan);
    color: #021018;
    font-family: var(--font-display);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    white-space: nowrap;
  }
  .plan__name {
    font-family: var(--font-display);
    font-size: 1.45rem;
    letter-spacing: -0.02em;
  }
  .plan__tagline {
    margin-top: 0.35rem;
    color: var(--muted);
    font-size: 0.95rem;
  }
  .plan__price {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 0.6rem;
    margin-top: 1.5rem;
  }
  .plan__price strong {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(2rem, 1.6rem + 1.4vw, 2.6rem);
    letter-spacing: -0.03em;
    line-height: 1;
  }
  .plan__price span {
    color: var(--muted);
    font-size: 0.92rem;
  }
  .plan__details {
    display: grid;
    gap: 0.2rem;
    margin-top: 0.75rem;
    font-size: 0.92rem;
    color: var(--cyan);
    font-weight: 600;
  }
  .plan__features {
    display: grid;
    gap: 0.75rem;
    flex: 1;
    margin: 1.6rem 0 1.75rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
  }
  .plan__features li {
    display: flex;
    gap: 0.7rem;
    align-items: flex-start;
    font-size: 0.97rem;
  }
  .plan__features :global(svg) {
    flex: none;
    margin-top: 0.15rem;
    color: var(--cyan);
  }
  .plans__note {
    max-width: 44rem;
    margin: 2.5rem auto 0;
    text-align: center;
    font-size: 0.9rem;
    color: var(--muted);
  }
  .plans__more {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.75rem 1rem;
    margin-top: 1.25rem;
    color: var(--muted);
    text-align: center;
  }

  @media (min-width: 900px) {
    /* Alinha o início das listas de benefícios entre os três cartões */
    .plan__pricing {
      min-height: 8.6rem;
    }
    .plan__tagline {
      min-height: 3.2em;
    }
    .plans__grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 1.5rem;
    }
    .plan--featured {
      margin-block: -0.75rem;
    }
  }
</style>
