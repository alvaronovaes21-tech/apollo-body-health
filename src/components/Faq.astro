---
import Icon from './Icon.astro';
import SectionHeading from './SectionHeading.astro';
import WhatsAppButton from './WhatsAppButton.astro';
import { FAQ } from '@/data/faq';
import { MESSAGES } from '@/lib/messages';
import { SECTIONS } from '@/config/site';
---

<section class="section faq" id={SECTIONS.faq} aria-labelledby="faq-title">
  <div class="container faq__wrap">
    <SectionHeading
      eyebrow="Perguntas frequentes"
      title="Tire suas dúvidas <em>antes de começar.</em>"
      id="faq-title"
    />

    <!-- Acordeão acessível baseado em <details>/<summary> nativos (teclado e leitores de tela). -->
    <div class="faq__list" data-reveal>
      {
        FAQ.map((item, i) => (
          <details class="faq__item" name="faq">
            <summary>
              <span>{item.question}</span>
              <span class="faq__icon" aria-hidden="true">
                <Icon name="plus" size={20} class="faq__plus" />
                <Icon name="minus" size={20} class="faq__minus" />
              </span>
            </summary>
            <div class="faq__answer">
              {item.answer.map((p) => (
                <p>{p}</p>
              ))}
              {item.cta && (
                <WhatsAppButton
                  message={MESSAGES.general}
                  origin={`faq-${i + 1}`}
                  category="faq"
                  item={item.question}
                  variant="ghost"
                >
                  Conversar com a equipe
                </WhatsAppButton>
              )}
            </div>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .faq {
    background: var(--bg);
  }
  .faq__wrap {
    max-width: 52rem;
  }
  .faq__list {
    display: grid;
    gap: 0.75rem;
  }
  .faq__item {
    border: 1px solid var(--line);
    border-radius: 18px;
    background: linear-gradient(180deg, rgb(255 255 255 / 0.035), rgb(255 255 255 / 0.01)), var(--surface);
    transition: border-color 0.25s var(--ease);
  }
  .faq__item[open] {
    border-color: rgb(25 195 255 / 0.45);
  }
  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 64px;
    padding: 1rem 1.4rem;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.02rem;
    line-height: 1.35;
    cursor: pointer;
    list-style: none;
    border-radius: 18px;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary:focus-visible {
    outline-offset: 2px;
  }
  .faq__icon {
    flex: none;
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    color: var(--cyan);
    border: 1px solid rgb(25 195 255 / 0.35);
  }
  .faq__icon :global(.faq__minus),
  .faq__item[open] .faq__icon :global(.faq__plus) {
    display: none;
  }
  .faq__item[open] .faq__icon :global(.faq__minus) {
    display: block;
  }
  .faq__answer {
    display: grid;
    gap: 0.8rem;
    justify-items: start;
    padding: 0 1.4rem 1.4rem;
    color: var(--muted);
    animation: reveal 0.3s var(--ease);
  }
  @keyframes reveal {
    from {
      opacity: 0;
      transform: translateY(-6px);
    }
  }
</style>
