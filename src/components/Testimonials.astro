---
import Icon from './Icon.astro';
import SectionHeading from './SectionHeading.astro';
import QuietCta from './QuietCta.astro';
import { SECTIONS } from '@/config/site';
import { formatRating, formatReviewDate, initials, loadReviewFeed } from '@/lib/reviews';

const feed = await loadReviewFeed();
const averageText = feed.averageRating !== null ? formatRating(feed.averageRating) : null;
const ratingLabel = averageText !== null ? `${averageText} de 5` : null;
const totalLabel =
  feed.totalReviews !== null
    ? `${feed.totalReviews.toLocaleString('pt-BR')} avaliações no Google`
    : null;
---

<section class="section reviews" id={SECTIONS.depoimentos} aria-labelledby="reviews-title">
  <div class="container">
    <SectionHeading
      eyebrow="Depoimentos no Google"
      title="Quem treina na Apollo, sente a <em>diferença.</em>"
      subtitle="Mais do que palavras nossas, veja o que os próprios alunos dizem sobre a experiência de treinar aqui."
      id="reviews-title"
    />

    {
      feed.reviews.length > 0 ? (
        <div data-reviews>
          {(ratingLabel || totalLabel) && (
            <p class="reviews__summary" data-reveal>
              <span class="reviews__mark" aria-hidden="true">
                <svg width="18" height="18" viewBox="0 0 18 18" focusable="false">
                  <path fill="#4285F4" d="M17.64 9.2c0-.64-.06-1.25-.16-1.84H9v3.48h4.84a4.14 4.14 0 0 1-1.8 2.72v2.26h2.91c1.7-1.57 2.68-3.88 2.68-6.62z" />
                  <path fill="#34A853" d="M9 18c2.43 0 4.47-.8 5.96-2.18l-2.91-2.26c-.8.54-1.84.86-3.05.86-2.34 0-4.33-1.58-5.04-3.71H.96v2.33A9 9 0 0 0 9 18z" />
                  <path fill="#FBBC05" d="M3.96 10.71A5.4 5.4 0 0 1 3.68 9c0-.59.1-1.17.28-1.71V4.96H.96A9 9 0 0 0 0 9c0 1.45.35 2.83.96 4.04l3-2.33z" />
                  <path fill="#EA4335" d="M9 3.58c1.32 0 2.51.45 3.44 1.35l2.58-2.58C13.46.89 11.43 0 9 0A9 9 0 0 0 .96 4.96L3.96 7.29C4.67 5.16 6.66 3.58 9 3.58z" />
                </svg>
              </span>
              {averageText && (
                <span>
                  <strong>{averageText}</strong>
                  <span class="sr-only"> de 5</span>
                </span>
              )}
              {ratingLabel && totalLabel && <span aria-hidden="true">·</span>}
              {totalLabel && <span>{totalLabel}</span>}
            </p>
          )}
          <p class="reviews__note">Seleção de avaliações sobre atendimento, professores e ambiente.</p>

          <ul class="reviews__track" data-reviews-track aria-label="Depoimentos de alunos no Google">
            {feed.reviews.map((review, index) => {
              const dateLabel = formatReviewDate(review.createdOn);
              const stars = review.rating === null ? null : Math.round(review.rating);
              return (
                <li class="reviews__item" data-reveal style={`--reveal-delay:${(index % 3) * 70}ms`}>
                  <article class="review card" data-review>
                    <header class="review__top">
                      {stars !== null && (
                        <p class="review__stars" aria-label={`${review.rating} de 5 estrelas`}>
                          <span aria-hidden="true">
                            {Array.from({ length: 5 }, (_, star) => (
                              <Icon name="star" size={16} class={star < stars ? 'is-on' : 'is-off'} />
                            ))}
                          </span>
                        </p>
                      )}
                      {dateLabel && (
                        <time datetime={review.createdOn.slice(0, 10)}>{dateLabel}</time>
                      )}
                    </header>
                    <p class="review__text" data-review-text>
                      {review.caption}
                    </p>
                    <button type="button" class="review__more" data-review-more hidden aria-expanded="false">
                      Ler mais
                    </button>
                    <footer class="review__person">
                      <span class="review__avatar" aria-hidden="true">
                        {review.profilePhotoUrl && (
                          <img
                            src={review.profilePhotoUrl}
                            alt=""
                            width="44"
                            height="44"
                            loading="lazy"
                            decoding="async"
                            referrerpolicy="no-referrer"
                          />
                        )}
                        <span class="review__initials">{initials(review.authorName)}</span>
                      </span>
                      <span class="review__who">
                        <span class="review__name">{review.authorName}</span>
                        {review.sourceLink ? (
                          <a
                            class="review__source"
                            href={review.sourceLink}
                            target="_blank"
                            rel="noopener noreferrer"
                          >
                            <span class="sr-only">Avaliação publicada no </span>
                            Google
                            <span class="sr-only"> (abre em nova aba)</span>
                          </a>
                        ) : (
                          <span class="review__source">Google</span>
                        )}
                      </span>
                    </footer>
                  </article>
                </li>
              );
            })}
          </ul>

          <div class="reviews__nav">
            <button type="button" data-reviews-prev aria-label="Depoimento anterior">
              <Icon name="chevron-left" size={22} />
            </button>
            <button type="button" data-reviews-next aria-label="Próximo depoimento">
              <Icon name="chevron-right" size={22} />
            </button>
          </div>
        </div>
      ) : (
        <p class="reviews__empty" role="status">
          {feed.unavailableReason}
        </p>
      )
    }

    {feed.reviews.length > 0 && <QuietCta origin="depoimentos" lead="Gostou do que os alunos contam?" />}
  </div>
</section>

<script>
  const root = document.querySelector<HTMLElement>('[data-reviews]');
  const track = root?.querySelector<HTMLElement>('[data-reviews-track]');
  const prev = root?.querySelector<HTMLButtonElement>('[data-reviews-prev]');
  const next = root?.querySelector<HTMLButtonElement>('[data-reviews-next]');

  if (root && track && prev && next) {
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const distance = () => {
      const card = track.querySelector('li');
      if (!card) return 300;
      const styles = getComputedStyle(track);
      const gap = Number.parseFloat(styles.columnGap || styles.gap || '16') || 16;
      return card.getBoundingClientRect().width + gap;
    };

    const update = () => {
      const max = track.scrollWidth - track.clientWidth;
      root.toggleAttribute('data-reviews-static', max <= 8);
      prev.disabled = track.scrollLeft <= 2;
      next.disabled = track.scrollLeft >= max - 2;
    };

    const scrollByCard = (direction: number) => {
      track.scrollBy({ left: direction * distance(), behavior: reduce ? 'auto' : 'smooth' });
    };

    prev.addEventListener('click', () => scrollByCard(-1));
    next.addEventListener('click', () => scrollByCard(1));
    track.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update);
    update();

    root.querySelectorAll('img').forEach((img) => {
      const drop = () => img.remove();
      if (img.complete && img.naturalWidth === 0) drop();
      else img.addEventListener('error', drop);
    });

    root.querySelectorAll<HTMLElement>('[data-review]').forEach((card) => {
      const text = card.querySelector<HTMLElement>('[data-review-text]');
      const button = card.querySelector<HTMLButtonElement>('[data-review-more]');
      if (!text || !button) return;
      const fullHeight = text.scrollHeight;
      text.classList.add('is-clamped');
      const overflowing = fullHeight > text.clientHeight + 2;
      if (!overflowing) {
        text.classList.remove('is-clamped');
        button.remove();
        return;
      }
      button.hidden = false;
      button.addEventListener('click', () => {
        const open = card.classList.toggle('is-open');
        text.classList.toggle('is-clamped', !open);
        button.setAttribute('aria-expanded', String(open));
        button.textContent = open ? 'Ler menos' : 'Ler mais';
      });
    });
  }
</script>

<style>
  .reviews {
    background:
      radial-gradient(50% 40% at 15% 0%, rgb(25 195 255 / 0.06), transparent 70%),
      var(--bg);
  }
  .reviews__summary {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.45rem 0.7rem;
    margin: -0.75rem auto clamp(1.4rem, 3vw, 2rem);
    color: var(--muted);
    font-size: 0.95rem;
  }
  .reviews__summary strong {
    color: var(--text);
    font-family: var(--font-display);
    font-size: 1.35rem;
    letter-spacing: -0.03em;
  }
  .reviews__mark {
    display: inline-flex;
  }
  .reviews__note {
    margin: -0.35rem auto 1.25rem;
    color: var(--muted);
    font-size: 0.88rem;
    text-align: center;
  }
  .reviews__track {
    display: flex;
    gap: 1rem;
    margin-inline: -0.15rem;
    padding: 0.2rem 0.15rem 0.4rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    overscroll-behavior-x: contain;
    scrollbar-width: none;
  }
  .reviews__track::-webkit-scrollbar {
    display: none;
  }
  .reviews__item {
    display: flex;
    flex: 0 0 min(86%, 21.5rem);
    scroll-snap-align: start;
  }
  .review {
    display: flex;
    flex: 1;
    flex-direction: column;
    padding: 1.25rem 1.25rem 1.15rem;
  }
  .review__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    min-height: 1.4rem;
  }
  .review__stars {
    display: inline-flex;
    color: #ffb542;
  }
  .review__stars span {
    display: inline-flex;
    gap: 0.12rem;
  }
  .review__stars :global(.is-off) {
    color: rgb(255 255 255 / 0.18);
  }
  .review__top time {
    color: var(--muted);
    font-size: 0.78rem;
    white-space: nowrap;
  }
  .review__text {
    margin-top: 0.9rem;
    white-space: pre-line;
    font-size: 0.98rem;
    line-height: 1.55;
  }
  .review__text.is-clamped {
    display: -webkit-box;
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 6;
  }
  .review__more {
    align-self: flex-start;
    margin-top: 0.55rem;
    padding: 0;
    border: 0;
    background: none;
    color: var(--cyan);
    font: inherit;
    font-size: 0.88rem;
    font-weight: 700;
    cursor: pointer;
  }
  .review__more:hover {
    text-decoration: underline;
  }
  .review__person {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-top: auto;
    padding-top: 1.1rem;
  }
  .review__avatar {
    position: relative;
    display: grid;
    flex: none;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    overflow: hidden;
    background: rgb(25 195 255 / 0.12);
    color: var(--cyan);
  }
  .review__avatar img,
  .review__initials {
    grid-area: 1 / 1;
    width: 44px;
    height: 44px;
  }
  .review__avatar img {
    position: relative;
    z-index: 1;
    object-fit: cover;
  }
  .review__initials {
    display: grid;
    place-items: center;
    font-family: var(--font-display);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.04em;
  }
  .review__who {
    display: grid;
    min-width: 0;
  }
  .review__name {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.95rem;
    line-height: 1.3;
  }
  .review__source {
    color: var(--muted);
    font-size: 0.78rem;
    text-decoration: none;
  }
  a.review__source:hover {
    color: var(--cyan);
  }
  .reviews__nav {
    display: flex;
    justify-content: center;
    gap: 0.6rem;
    margin-top: 1.1rem;
  }
  [data-reviews][data-reviews-static] .reviews__nav {
    display: none;
  }
  .reviews__nav button {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 999px;
    border: 1px solid var(--line-strong);
    background: rgb(255 255 255 / 0.03);
    color: var(--text);
    cursor: pointer;
  }
  .reviews__nav button:hover {
    border-color: var(--cyan);
    color: var(--cyan);
  }
  .reviews__nav button:disabled {
    opacity: 0.35;
    cursor: default;
  }
  .reviews__empty {
    max-width: 40rem;
    margin-inline: auto;
    padding: 1.25rem 1.35rem;
    border: 1px dashed var(--line-strong);
    border-radius: 18px;
    color: var(--muted);
    text-align: center;
  }

  @media (min-width: 800px) {
    .reviews__item {
      flex-basis: calc((100% - 1rem) / 2.15);
    }
  }
  @media (min-width: 1100px) {
    .reviews__item {
      flex-basis: calc((100% - 2rem) / 3);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .reviews__track {
      scroll-behavior: auto;
    }
  }
</style>
