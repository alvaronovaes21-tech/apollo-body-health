---
import Icon from './Icon.astro';
import SectionHeading from './SectionHeading.astro';
import QuietCta from './QuietCta.astro';
import type { IconName } from './icon-names.ts';
import { SECTIONS } from '@/config/site';

const rows: { icon: IconName; common: string; apollo: string }[] = [
  {
    icon: 'users',
    common: 'Professores distantes e pouco disponíveis',
    apollo: 'Professores cuidadosos e presentes durante o treino',
  },
  {
    icon: 'clock',
    common: 'Filas nos aparelhos e dificuldade para treinar nos horários de maior movimento',
    apollo: 'Um ambiente que favorece um treino mais tranquilo e organizado',
  },
  {
    icon: 'heart-pulse',
    common: 'Treinos genéricos que nem sempre acompanham sua evolução',
    apollo: 'Orientação e treino de acordo com seus objetivos',
  },
  {
    icon: 'sparkles',
    common: 'Você é apenas mais um número na catraca',
    apollo: 'Você é conhecido pelo nome e recebe atenção individualizada',
  },
];
---

<section class="section compare" id={SECTIONS.comparacao} aria-labelledby="compare-title">
  <div class="container">
    <SectionHeading
      eyebrow="O diferencial Apollo"
      title="Mais do que uma academia. Um lugar onde você é <em>acompanhado.</em>"
      subtitle="Você não precisa escolher entre pagar um preço acessível e receber atenção de verdade."
      id="compare-title"
    />

    <div class="compare__board">
      <div class="compare__head" aria-hidden="true">
        <p>Em uma academia de rede</p>
        <p>Na Apollo Body &amp; Health</p>
      </div>
      <ul class="compare__rows">
        {
          rows.map((row, index) => (
            <li class="compare__row" data-reveal style={`--reveal-delay:${index * 70}ms`}>
              <div class="compare__cell compare__cell--other">
                <p class="compare__label">Em uma academia de rede</p>
                <p class="compare__copy">
                  <Icon name={row.icon} size={18} />
                  <span>{row.common}</span>
                </p>
              </div>
              <div class="compare__cell compare__cell--apollo">
                <p class="compare__label">Na Apollo Body &amp; Health</p>
                <p class="compare__copy">
                  <Icon name={row.icon} size={18} />
                  <span>{row.apollo}</span>
                </p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>

    <QuietCta origin="comparacao" lead="Quer conhecer os planos e garantir sua vaga?" />
  </div>
</section>

<style>
  .compare {
    background:
      radial-gradient(55% 45% at 80% 0%, rgb(25 195 255 / 0.07), transparent 68%),
      var(--bg-soft);
  }
  .compare__board {
    display: grid;
    gap: 0.85rem;
  }
  .compare__head {
    display: none;
  }
  .compare__rows {
    display: grid;
    gap: 0.85rem;
  }
  .compare__row {
    display: grid;
    gap: 0.75rem;
    padding: 0.8rem;
    border: 1px solid var(--line);
    border-radius: 22px;
    background: linear-gradient(180deg, rgb(255 255 255 / 0.03), rgb(255 255 255 / 0.01)), var(--surface);
  }
  .compare__cell {
    position: relative;
  }
  .compare__cell--other {
    padding: 0.35rem 0.45rem 0.85rem;
    border-bottom: 1px solid var(--line);
  }
  .compare__cell--apollo {
    padding: 0.85rem 0.9rem;
    border-radius: 16px;
    border: 1px solid rgb(25 195 255 / 0.4);
    background: linear-gradient(180deg, rgb(25 195 255 / 0.14), rgb(25 195 255 / 0.04));
  }
  .compare__label {
    margin-bottom: 0.45rem;
    font-family: var(--font-display);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .compare__cell--apollo .compare__label {
    color: var(--cyan);
  }
  .compare__copy {
    display: flex;
    align-items: flex-start;
    gap: 0.7rem;
    font-size: 0.98rem;
    line-height: 1.45;
  }
  .compare__cell--other .compare__copy {
    color: var(--muted);
  }
  .compare__cell--apollo .compare__copy {
    color: var(--text);
    font-weight: 600;
  }
  .compare__copy :global(svg) {
    flex: none;
    margin-top: 0.15rem;
  }
  .compare__cell--other .compare__copy :global(svg) {
    color: rgb(163 175 189 / 0.8);
  }
  .compare__cell--apollo .compare__copy :global(svg) {
    color: var(--cyan);
  }

  @media (min-width: 860px) {
    .compare__board {
      padding: clamp(1.1rem, 2vw, 1.5rem);
      border: 1px solid var(--line);
      border-radius: 28px;
      background: linear-gradient(180deg, rgb(255 255 255 / 0.03), transparent 28%), #080d14;
    }
    .compare__head {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0.85rem;
      padding: 0.2rem 1.2rem 0.45rem;
    }
    .compare__head p {
      font-family: var(--font-display);
      font-size: 0.74rem;
      font-weight: 700;
      letter-spacing: 0.16em;
      text-transform: uppercase;
    }
    .compare__head p:first-child {
      color: var(--muted);
    }
    .compare__head p:last-child {
      color: var(--cyan);
    }
    .compare__rows {
      gap: 0.75rem;
    }
    .compare__row {
      grid-template-columns: 1fr 1fr;
      gap: 0.85rem;
      padding: 0;
      border: 0;
      border-radius: 0;
      background: none;
    }
    .compare__cell--other,
    .compare__cell--apollo {
      min-height: 100%;
      padding: 1.15rem 1.2rem;
      border-radius: 18px;
      border: 1px solid var(--line);
    }
    .compare__cell--other {
      border-bottom: 1px solid var(--line);
      background: rgb(255 255 255 / 0.02);
    }
    .compare__label {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
      border: 0;
    }
  }
</style>
