---
import Icon from './Icon.astro';
import Button from './Button.astro';
import SectionHeading from './SectionHeading.astro';
import WhatsAppButton from './WhatsAppButton.astro';
import { CONTACT, LOCATION, SECTIONS, SITE } from '@/config/site';
import { MESSAGES } from '@/lib/messages';

// "Como chegar": abre o mesmo link oficial do Maps (o app oferece o botão de rotas).
const hasAddress = Boolean(LOCATION.address);
---

<section class="section location" id={SECTIONS.contato} aria-labelledby="location-title">
  <div class="container location__grid">
    <div data-reveal>
      <SectionHeading
        eyebrow="Localização e contato"
        title="A Apollo está mais perto <em>do que você imagina.</em>"
        subtitle="Conheça nosso espaço e descubra uma nova experiência de treino."
        id="location-title"
        align="left"
      />

      <ul class="location__info">
        <li>
          <span class="location__icon"><Icon name="pin" size={22} /></span>
          <div>
            <strong>{SITE.city}, Bahia</strong>
            {hasAddress && <span>{LOCATION.address}{LOCATION.neighborhood ? ` — ${LOCATION.neighborhood}` : ''}</span>}
            {!hasAddress && <span>Abra o Google Maps para ver a localização exata.</span>}
          </div>
        </li>
        <li>
          <span class="location__icon"><Icon name="whatsapp" size={22} /></span>
          <div>
            <strong>WhatsApp</strong>
            <span>{CONTACT.phoneDisplay}</span>
          </div>
        </li>
      </ul>

      <div class="location__actions">
        <Button
          href={LOCATION.mapsUrl}
          size="lg"
          icon="pin"
          track="maps"
          origin="localizacao"
          category="ver-localizacao"
          ariaLabel="Ver localização no Google Maps"
        >
          Ver localização no Google Maps
        </Button>
        <Button
          href={LOCATION.mapsUrl}
          size="lg"
          variant="secondary"
          icon="route"
          track="maps"
          origin="localizacao"
          category="como-chegar"
        >
          Como chegar
        </Button>
      </div>
      <p class="location__help">
        Dúvidas para chegar?
        <WhatsAppButton message={MESSAGES.location} origin="localizacao" category="location" variant="ghost">
          Pergunte à equipe
        </WhatsAppButton>
      </p>
    </div>

    <div class="location__map" data-reveal style="--reveal-delay:120ms">
      {
        LOCATION.embedUrl ? (
          <iframe
            src={LOCATION.embedUrl}
            title="Mapa com a localização da Apollo Body & Health"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            allowfullscreen
          />
        ) : (
          <a
            class="location__card"
            href={LOCATION.mapsUrl}
            target="_blank"
            rel="noopener noreferrer"
            data-track="maps"
            data-origin="localizacao-cartao"
            data-category="ver-localizacao"
          >
            <span class="location__pin"><Icon name="pin" size={34} /></span>
            <strong>Apollo Body &amp; Health</strong>
            <span>{SITE.city}, Bahia</span>
            <span class="location__link">
              Abrir no Google Maps <Icon name="arrow-up-right" size={18} />
            </span>
            <span class="sr-only">(abre em nova aba)</span>
          </a>
        )
      }
    </div>
  </div>
</section>

<style>
  .location {
    background: linear-gradient(180deg, var(--bg) 0%, var(--bg-soft) 100%);
  }
  .location__grid {
    display: grid;
    gap: 2.5rem;
    align-items: center;
  }
  .location :global(.heading) {
    margin-bottom: 1.75rem;
  }
  .location__info {
    display: grid;
    gap: 1rem;
    margin-bottom: 2rem;
  }
  .location__info li {
    display: flex;
    align-items: center;
    gap: 1rem;
  }
  .location__info strong {
    display: block;
    font-family: var(--font-display);
  }
  .location__info span:not(.location__icon) {
    display: block;
    color: var(--muted);
    font-size: 0.95rem;
  }
  .location__icon {
    flex: none;
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    border-radius: 14px;
    color: var(--cyan);
    background: rgb(25 195 255 / 0.1);
    border: 1px solid rgb(25 195 255 / 0.28);
  }
  .location__actions {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .location__help {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1rem;
    margin-top: 1.5rem;
    color: var(--muted);
    font-size: 0.95rem;
  }
  .location__map {
    position: relative;
    aspect-ratio: 4 / 3;
    border-radius: 28px;
    overflow: hidden;
    border: 1px solid var(--line-strong);
    background: var(--surface);
  }
  .location__map iframe {
    width: 100%;
    height: 100%;
    border: 0;
    filter: grayscale(0.4) contrast(1.05);
  }
  .location__card {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.35rem;
    padding: 1.5rem;
    text-align: center;
    text-decoration: none;
    background:
      radial-gradient(50% 50% at 50% 42%, rgb(25 195 255 / 0.2), transparent 70%),
      linear-gradient(rgb(255 255 255 / 0.04) 1px, transparent 1px) 0 0 / 100% 44px,
      linear-gradient(90deg, rgb(255 255 255 / 0.04) 1px, transparent 1px) 0 0 / 44px 100%,
      #0a1017;
    transition: background-color 0.3s var(--ease);
  }
  .location__pin {
    display: grid;
    place-items: center;
    width: 76px;
    height: 76px;
    margin-bottom: 0.75rem;
    border-radius: 50%;
    color: #021018;
    background: var(--cyan);
    box-shadow:
      0 0 0 12px rgb(25 195 255 / 0.15),
      0 0 50px rgb(25 195 255 / 0.5);
  }
  .location__card strong {
    font-family: var(--font-display);
    font-size: 1.3rem;
  }
  .location__card > span {
    color: var(--muted);
  }
  .location__link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: 1rem;
    color: var(--cyan) !important;
    font-weight: 700;
  }
  .location__card:hover .location__link {
    text-decoration: underline;
  }
  @media (min-width: 560px) {
    .location__actions {
      flex-direction: row;
      flex-wrap: wrap;
    }
  }
  @media (min-width: 980px) {
    .location__grid {
      grid-template-columns: 1fr 1fr;
      gap: 4rem;
    }
    .location__map {
      aspect-ratio: 1 / 1;
    }
  }
</style>
