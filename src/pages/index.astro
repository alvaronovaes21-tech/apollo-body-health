---
import Layout from '@/layouts/Layout.astro';
import Header from '@/components/Header.astro';
import Hero from '@/components/Hero.astro';
import ValueProps from '@/components/ValueProps.astro';
import Modalities from '@/components/Modalities.astro';
import JudoHighlight from '@/components/JudoHighlight.astro';
import Plans from '@/components/Plans.astro';
import Benefits from '@/components/Benefits.astro';
import Schedule from '@/components/Schedule.astro';
import Gallery from '@/components/Gallery.astro';
import VideoSection from '@/components/VideoSection.astro';
import Location from '@/components/Location.astro';
import Faq from '@/components/Faq.astro';
import FinalCta from '@/components/FinalCta.astro';
import Footer from '@/components/Footer.astro';
import WhatsAppFloat from '@/components/WhatsAppFloat.astro';
---

<Layout>
  <Header />
  <main id="conteudo">
    <Hero />
    <ValueProps />
    <Modalities />
    <JudoHighlight />
    <Plans />
    <Benefits />
    <Schedule />
    <Gallery />
    <VideoSection />
    <Location />
    <Faq />
    <FinalCta />
  </main>
  <Footer />
  <WhatsAppFloat />
</Layout>
